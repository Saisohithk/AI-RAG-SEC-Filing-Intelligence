# ============================================================
# SEC RAG System — Environment Variables Template
# 1. Copy this file:  cp .env.example .env   (or: copy .env.example .env)
# 2. Fill in your keys below (all services have free tiers)
# 3. NEVER commit .env to git — it is already in .gitignore
# ============================================================

# ---------------------------------------------------------------------------
# EMBEDDINGS
# ---------------------------------------------------------------------------
# Jina AI — 8,192-token context window, 768 dims, 1M tokens/month free
# Get key → https://jina.ai
# Leave blank to use the free local SentenceTransformer (all-MiniLM-L6-v2, 384 dims)
JINA_API_KEY=

# ---------------------------------------------------------------------------
# VECTOR DATABASE  (choose one via USE_LOCAL_CHROMA)
# ---------------------------------------------------------------------------
# Pinecone — cloud, serverless, scales to billions of vectors
# Get key → https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sec-rag
PINECONE_DIMENSION=768

# true  = ChromaDB stored on local disk (./chroma_db) — no key needed
# false = Pinecone cloud — requires PINECONE_API_KEY above
USE_LOCAL_CHROMA=true
CHROMA_PERSIST_DIR=./chroma_db

# ---------------------------------------------------------------------------
# LLM PROVIDERS  (use at least one)
# ---------------------------------------------------------------------------

# Groq — fastest cloud inference (~500 tokens/sec), Llama 3.3 70B
# Get key → https://console.groq.com
GROQ_API_KEY=

# Google Gemini — best quality on complex financial questions, free tier
# Get key → https://aistudio.google.com
GOOGLE_API_KEY=

# Ollama — fully local, no API key, no cost, no internet required
# Install → https://ollama.ai  then run:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default provider used when UI first loads
# Options: "ollama" | "groq" | "gemini"
DEFAULT_LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
# LangSmith — traces every LLM call: prompt, response, latency, tokens
# Get key → https://smith.langchain.com
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sec-rag

# ---------------------------------------------------------------------------
# CHUNKING & RETRIEVAL TUNING  (defaults are production-tested)
# ---------------------------------------------------------------------------
CHUNK_SIZE=512        # Max characters per chunk
CHUNK_OVERLAP=64      # Overlap between adjacent chunks (preserves context at boundaries)
TOP_K_RETRIEVAL=20    # Candidates fetched from hybrid search before reranking
TOP_K_RERANK=5        # Final chunks kept after BGE cross-encoder reranking

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# API key required in X-API-Key header on all endpoints (except /health)
# Leave blank to disable authentication (local dev only)
API_KEY=

# Comma-separated list of allowed CORS origins
# Use "*" for open access (local dev) or your exact frontend URL in production
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# REDIS  (optional — enables query caching + async ingestion queue)
# ---------------------------------------------------------------------------
# Leave blank to use in-process BackgroundTasks and no caching
# Example: redis://localhost:6379/0   or   redis://redis:6379/0 (Docker)
REDIS_URL=

# ---------------------------------------------------------------------------
# BM25 PERSISTENCE
# ---------------------------------------------------------------------------
# Path where the serialized BM25 index is saved after ingestion
# Eliminates ~20s cold-start rebuild cost on restart
BM25_INDEX_PATH=./data/bm25_index.pkl
